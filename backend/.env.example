# Copy to backend/.env and fill in. Never commit the real file.
# Without credentials the backend runs in clearly labelled DEMO DATA mode.
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=
METEOMATICS_BASE_URL=https://api.meteomatics.com

# Optional
# FALAJLINE_WEATHER_CACHE_TTL_S=10800   # seconds a weather response is reused (default 3 h)
# FALAJLINE_SIM_ANCHOR=2026-11-16       # date the simulated telemetry scenario is anchored to (default: server start date)
# FALAJLINE_FORCE_DEMO=1                # ignore credentials and use demo weather
# FALAJLINE_WEATHER_DAILY_BUDGET=400     # max Meteomatics queries per server instance per day
# FALAJLINE_REFRESH_TOKEN=              # if set, POST /api/weather/refresh needs it as a Bearer token (otherwise refresh is local-only)
